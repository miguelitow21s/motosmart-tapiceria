      "refersTo": "button-danger",
      "description": "Solo para borrar o deshacer algo que no se recupera. Rojo de peligro, distinto del rojo de marca.",
      "html": "<button class=\"ds-btn-danger\">Sí, borrar</button>",
      "css": ".ds-btn-danger{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:48px;padding:0 20px;border:0;border-radius:8px;background:var(--color-danger,#b3261e);color:#fff;font-family:inherit;font-weight:600;font-size:0.9375rem;line-height:1.5;cursor:pointer;transition:background-color 150ms,border-color 150ms,transform 150ms cubic-bezier(0.23,1,0.32,1);}.ds-btn-danger:hover{background:var(--color-danger-hover,#8f1e18)}.ds-btn-danger:active{transform:scale(.97)}.ds-btn-danger:focus-visible{outline:2px solid #111;outline-offset:2px}"
