      "description": "Acción principal del panel de administración: tinta sólida. El rojo queda para borrar.",
      "html": "<button class=\"ds-btn-dark\">Guardar cambios</button>",
      "css": ".ds-btn-dark{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:48px;padding:0 20px;border:0;border-radius:8px;background:var(--color-ink,#111);color:var(--color-bg,#fff);font-family:inherit;font-weight:600;font-size:0.9375rem;line-height:1.5;cursor:pointer;transition:background-color 150ms,border-color 150ms,transform 150ms cubic-bezier(0.23,1,0.32,1);}.ds-btn-dark:hover{background:var(--color-ink-2,#4d4d4d)}.ds-btn-dark:active{transform:scale(.97)}.ds-btn-dark:focus-visible{outline:2px solid #111;outline-offset:2px}"
    },
    {
