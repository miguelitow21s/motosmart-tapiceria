      "html": "<button class=\"ds-btn-secondary\">Ver catálogo</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:48px;padding:0 20px;border:0;border-radius:8px;background:var(--color-bg,#fff);color:var(--color-ink,#111);font-family:inherit;font-weight:600;font-size:0.9375rem;line-height:1.5;cursor:pointer;transition:background-color 150ms,border-color 150ms,transform 150ms cubic-bezier(0.23,1,0.32,1);border:1px solid var(--color-line-strong,#c9c9c5);}.ds-btn-secondary:hover{border-color:var(--color-ink,#111);background:var(--color-surface,#f5f5f3)}.ds-btn-secondary:active{transform:scale(.97)}.ds-btn-secondary:focus-visible{outline:2px solid #111;outline-offset:2px}"
    },
